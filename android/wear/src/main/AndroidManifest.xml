<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- A separate watch-only APK/AAB. Never put this feature in the phone manifest. -->
    <uses-feature android:name="android.hardware.type.watch" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false"
        android:icon="@drawable/ic_wear"
        android:label="MOVO"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- No secrets or ledger data on the watch; the Android phone remains required. -->
        <meta-data android:name="com.google.android.wearable.standalone" android:value="false" />
        <activity
            android:name=".WearActivity"
            android:exported="true"
            android:label="MOVO">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
