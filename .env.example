# Copy to .env.local for local development and replace with a dedicated MOVO Supabase project.
# These values are public browser configuration; the database must enforce RLS.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# NEVER add SUPABASE_SERVICE_ROLE_KEY to REACT_APP_* variables or client-side code.
