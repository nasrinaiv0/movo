# MOVO environment variable inventory
# Copy this file to .env.local for local development; NEVER commit .env.local or real credentials.
# This template includes verified runtime variable names and store-verification
# variables registered for MOVO in Vercel as of 2026-11-09. This is an inventory, NOT proof that every entry is needed by current code.
# Values that are credentials are intentionally blank. Configure only the integrations in use.
#
# IMPORTANT: MOVO currently uses Create React App (react-scripts), not Next.js.
# REACT_APP_* values are embedded in the PUBLIC browser bundle at BUILD TIME.
# Only use public project URLs / publishable (anon) keys in REACT_APP_* variables.
# Never put service_role, secret keys, passwords, or OAuth client secrets in REACT_APP_*.
# NEXT_PUBLIC_* entries are retained to document existing Vercel settings, but are
# not consumed by the current Create React App frontend.
#
# Required for authenticated MOVO frontend (src/lib/supabaseClient.js):
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Supabase server configuration (api/nasrinai/chat.js reads URL and anon key).
# Service role key is server-only; do not use it for user-scoped financial reads.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Other existing Supabase Vercel configuration / compatibility entries.
# Do NOT expose the JWT secret or secret key to the browser.
SUPABASE_JWT_SECRET=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Existing PostgreSQL integration variables in Vercel.
# Configure only if the deployed backend actually uses direct PostgreSQL access.
# These must remain server-only.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Server-side NasrinAI integration (api/nasrinai/chat.js).
# Without NASRINAI_API_KEY, AI proxy requests must fail closed.
NASRINAI_API_KEY=
NASRINAI_BASE_URL=https://nasrinai.com

# API CORS allowlist: exact comma-separated origins. Review against real deployed domains.
MOVO_ALLOWED_ORIGINS=https://movo.nasrinai.com,https://movo-lime.vercel.app

# Crypto market (api/crypto.js currently checks COINBEACON_API_KEY).
# COINPAPRIKA_API_KEY exists in Vercel and older docs, but is NOT the key read by
# the currently reviewed /api/crypto.js. Obtain a suitable commercial-data licence.
COINBEACON_API_KEY=
COINPAPRIKA_API_KEY=

# App Store / Google Play subscription rollout.
# Keep billing explicitly off until verified server-side purchase validation,
# restore purchases, store credentials, and release tests are complete.
MOVO_STORE_BILLING_ENABLED=false
# Optional comma-separated internal tester user UUIDs (server-only).
MOVO_STORE_TEST_USER_IDS=

# OAuth provider setup (NOT Vercel variables in the verified current implementation):
# Google OAuth: Supabase Dashboard > Authentication > Providers > Google.
#   Configure Google OAuth Client ID + Client Secret in Supabase; set Google's
#   authorized redirect URI to https://<project-ref>.supabase.co/auth/v1/callback
# Apple OAuth: Supabase Dashboard > Authentication > Providers > Apple.
#   Configure the Apple provider's required identifiers/key there.
# Supabase Auth > URL Configuration: set Site URL and allowed MOVO redirect origins.
# Google/Apple provider secrets MUST NOT appear in this browser-exposed template.
# Confirmed store verification configuration used in api/lib/purchaseVerification.js
# and purchase-notification routes; set real values privately before enabling billing.
# Apple: signed transaction and server notification verification.
APPLE_ROOT_CERTS_BASE64=
APPLE_APP_ID=
APPLE_IAP_SIGNING_KEY=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
# Google Play Developer API and authenticated Pub/Sub RTDN notifications.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=com.nasrinai.movo
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=
# Google OAuth Client ID and Secret belong in Supabase Auth > Google Provider.
# Apple OAuth provider credentials belong in Supabase Auth > Apple Provider.
#
# NODE_ENV is provided by the build/runtime; do not manually set it here.
